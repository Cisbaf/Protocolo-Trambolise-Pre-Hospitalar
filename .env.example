# ==========================================================
# Template do ambiente de DESENVOLVIMENTO.
#
# Gere o .env real com:  ./protocolo setup dev
# NUNCA commite o .env (ele esta no .gitignore).
# ==========================================================

# ---- Identificacao do ambiente (usado pelos scripts) ----
APP_ENV=dev

# ---- Portas publicadas no host ----
AVC_FRONT_PORT=5173
AVC_BACK_PORT=8080
DB_PORT=3306

# ---- Frontend ----
# Em dev o front fala com o back pela URL abaixo, mas so a PORTA e' usada:
# o host vem sempre da pagina aberta no navegador. Assim o mesmo .env serve
# para http://localhost:5174 e para http://<ip-da-maquina>:5174, e o cookie
# de sessao continua same-site (ver vite-protocolo/src/settings.ts).
# Em producao VITE_MODE fica vazio e o front usa a origem da propria pagina.
VITE_API_URL=http://localhost:${AVC_BACK_PORT}
VITE_MODE=dev

# ---- Banco de dados (container mysql-db do docker-compose.dev.yml) ----
DB_PROTOCOL_URL=jdbc:mysql://mysql-db:3306/protocolo?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Sao_Paulo
DB_PROTOCOL_USER=root
DB_PROTOCOL_PASSWORD=rootpass

# ---- Credenciais do container MySQL (apenas dev) ----
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=protocolo
MYSQL_USER=devuser
MYSQL_PASSWORD=devpass

# ---- Logs ----
LOG_PROTOCOL_PATH=logs/logs-protocolo.txt

# ---- JWT ----
# Em dev pode ser fixo. Em producao use um segredo unico (>= 32 caracteres).
JWT_SECRET=devSecretKeyThatIsAtLeast256BitsLongForHS256Algorithm1234567890123456789012
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=3600000

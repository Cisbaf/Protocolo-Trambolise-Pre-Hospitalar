# ==========================================================
# Template do ambiente de PRODUCAO.
#
# Gere o .env real com:  ./protocolo setup prod
# NUNCA commite o .env (ele esta no .gitignore).
#
# Os nomes das variaveis sao exatamente os mesmos que o
# servidor ja usa hoje - nada aqui muda o comportamento atual.
# ==========================================================

# ---- Identificacao do ambiente (usado pelos scripts) ----
APP_ENV=prod

# ---- Portas publicadas no host ----
AVC_FRONT_PORT=8019
AVC_BACK_PORT=8018

# ---- Frontend ----
# ATENCAO: VITE_MODE deve ficar VAZIO em producao.
# Com VITE_MODE vazio o front usa a origem da propria pagina como BaseURL
# (ver vite-protocolo/src/settings.ts). Definir VITE_MODE=dev aqui quebra
# o acesso via dominio/proxy reverso.
VITE_API_URL=http://192.168.1.10:${AVC_BACK_PORT}
VITE_MODE=

# ---- Banco de dados (MySQL externo, fora do compose) ----
DB_PROTOCOL_URL=jdbc:mysql://192.168.1.10:3306/protocolo
DB_PROTOCOL_USER=TROQUE_ME
DB_PROTOCOL_PASSWORD=TROQUE_ME

# ---- Logs ----
LOG_PROTOCOL_PATH=logs/logs-protocolo.txt

# ---- JWT ----
# Gere com: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=TROQUE_ME
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=3600000
